# =============================================================================
# InterviewSense Frontend — Vercel environment
#
# Copy to .env for local production builds, or paste keys into
# Vercel → Project → Settings → Environment Variables.
#
#   VITE_API_URL = https://interviewsense-api.onrender.com
#
# No trailing slash. Vite only exposes variables prefixed with VITE_.
# In local dev leave it empty — Vite's dev proxy forwards /api to :8000.
# =============================================================================

VITE_API_URL=
